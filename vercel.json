{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "astro-dist",
  "routes": [
    {
      "src": "/montres/(azur|emeraude|minuit)",
      "dest": "/product.html?watch=$1"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
